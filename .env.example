# Copy to .env and fill in. Never commit .env.
# A long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=District Social Welfare Officer
# Public address of the portal. Locally: http://localhost:8000 with SITE_ADDRESS=:8000.
# On a server: https://<domain> with SITE_ADDRESS=<domain>.
PUBLIC_BASE_URL=http://localhost:8000
SITE_ADDRESS=:8000
# Application window per the current government order (YYYY-MM-DD HH:MM, IST).
SCHEME_DEADLINE=2026-12-31 23:59
# Blocks where applying through an AI assistant is open (pilot).
AGENT_PILOT_BLOCKS=Sonari,Rajapara,Dhemaji Pathar,Namti
